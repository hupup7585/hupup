# ---- Database (Neon / Vercel Postgres pooled connection string) ----
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# ---- Site ----
# Public URL of the site, used to build Twilio webhook URLs and links. No trailing slash.
PUBLIC_BASE_URL=https://hupupattractions.com
# Hotline number shown on the landing page (display format)
NEXT_PUBLIC_HOTLINE_DISPLAY=(845) 000-0000
# Same number in E.164 for tel: links
NEXT_PUBLIC_HOTLINE_E164=+18450000000
# Time zone for "today", calendars and dates
BUSINESS_TIMEZONE=America/New_York

# ---- Admin sign-in (one-time codes) ----
ADMIN_EMAIL=hupupattractions@gmail.com
ADMIN_PHONE=+1845XXXXXXX
# Long random string (e.g. `openssl rand -hex 32`)
AUTH_SECRET=change-me

# ---- Twilio (phone hotline + SMS) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The Twilio number customers call and that sends texts, E.164
TWILIO_PHONE_NUMBER=+1845XXXXXXX
# Where "press 0" forwards to (defaults to ADMIN_PHONE)
FORWARD_PHONE=
# Hotline voice: Google Chirp3-HD "Fenrir" (young, friendly male). Plain text prompts only (no SSML).
IVR_VOICE=Google.en-US-Chirp3-HD-Fenrir

# ---- Email (Resend) for admin codes & optional receipts ----
RESEND_API_KEY=
EMAIL_FROM=Hup Up Attractions <noreply@hupupattractions.com>

# ---- Sola Payments (Cardknox) ----
# Gateway API key (xKey) - used to verify payments
SOLA_API_KEY=
# PaymentSITE page name: https://secure.cardknox.com/<this>
SOLA_PAYMENTSITE_NAME=
# Webhook PIN set in the Sola portal (15+ alphanumeric chars) - verifies ck-signature
SOLA_WEBHOOK_PIN=

# ---- Cron ----
# Vercel sets this automatically for cron requests when defined in project env
CRON_SECRET=change-me
