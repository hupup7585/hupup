  "incoming": "<?xml version="1.0" encoding="UTF-8"?><Response><Gather input="dtmf" numDigits="1" timeout="1" finishOnKey="#" actionOnEmptyResult="true" action="https://hupup.example/api/voice/closed-key" method="POST"><Say voice="Google.en-US-Chirp3-HD-Puck" language="en-US">Thank you for calling Hup Up Attractions. We are closed now for Shabbes, and we will be open again on Saturday at 6:07 PM. Please leave your name, phone number, and a short message after the tone, and we will call you back after Shabbes. Good Shabbes!</Say></Gather><Record maxLength="120" playBeep="true" finishOnKey="#" timeout="6" action="https://hupup.example/api/voice/vm-recorded?b=2&amp;x=closed&amp;t=*" method="POST" recordingStatusCallback="https://hupup.example/api/voice/vm-recording?b=2&amp;t=*" recordingStatusCallbackEvent="completed" recordingStatusCallbackMethod="POST" transcribe="false"/></Response>",
