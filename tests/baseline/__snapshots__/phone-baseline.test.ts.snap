exports[`baseline: every phone step as it plays today > addr-phone 1`] = `"<?xml version="1.0" encoding="UTF-8"?><Response><Gather input="dtmf" numDigits="11" timeout="5" finishOnKey="#" action="https://hupup.example/api/voice/addr-phone-heard" method="POST"><Say voice="Google.en-US-Chirp3-HD-Puck" language="en-US">Please enter a 10-digit phone number, starting with the area code.</Say><Say voice="Google.en-US-Chirp3-HD-Puck" language="en-US">When you are done, press pound.</Say><Play>https://hupup.example/audio/pause-500ms.wav</Play><Say voice="Google.en-US-Chirp3-HD-Puck" language="en-US">To go back, press star.</Say></Gather><Redirect method="POST">https://hupup.example/api/voice/idle?to=addr-phone</Redirect></Response>"`;

