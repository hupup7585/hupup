exports[`baseline: every phone step as it plays today > voicemail 1`] = `"<?xml version="1.0" encoding="UTF-8"?><Response><Gather input="dtmf" numDigits="1" timeout="1" finishOnKey="#" actionOnEmptyResult="true" action="https://hupup.example/api/voice/vm-greeting-key?g=vm_greeting" method="POST"><Say voice="Google.en-US-Chirp3-HD-Puck" language="en-US">We apologize that we are unable to answer your call. Our team is assisting other customers right now. Please feel free to leave a message after the tone and we will get back to you as soon as possible. When you are finished, you may hang up or press the pound key.</Say></Gather><Record maxLength="120" playBeep="true" finishOnKey="#" timeout="6" action="https://hupup.example/api/voice/vm-recorded?b=1&amp;t=*" method="POST" recordingStatusCallback="https://hupup.example/api/voice/vm-recording?b=1&amp;t=*" recordingStatusCallbackEvent="completed" recordingStatusCallbackMethod="POST" transcribe="false"/></Response>"`;

exports[`baseline: every phone step as it plays today > voicemail-done 1`] = `"<?xml version="1.0" encoding="UTF-8"?><Response><Hangup/></Response>"`;

