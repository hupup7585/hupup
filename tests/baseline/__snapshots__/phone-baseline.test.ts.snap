exports[`baseline: every phone step as it plays today > addr-lookup 1`] = `"<?xml version="1.0" encoding="UTF-8"?><Response><Gather input="dtmf" numDigits="1" timeout="5" finishOnKey="" action="https://hupup.example/api/voice/addr-lookup-choice" method="POST"><Say voice="Google.en-US-Chirp3-HD-Puck" language="en-US">Next, we need the delivery address.</Say><Say voice="Google.en-US-Chirp3-HD-Puck" language="en-US">To look it up with the number you are calling from, press 1. To look it up with a different phone number, press 2. To enter the address manually, press 3.</Say><Play>https://hupup.example/audio/pause-500ms.wav</Play><Say voice="Google.en-US-Chirp3-HD-Puck" language="en-US">To go back, press star.</Say></Gather><Redirect method="POST">https://hupup.example/api/voice/idle?to=addr-lookup</Redirect></Response>"`;

