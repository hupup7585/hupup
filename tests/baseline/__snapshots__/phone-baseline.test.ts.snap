exports[`baseline: every phone step as it plays today > added-menu 1`] = `"<?xml version="1.0" encoding="UTF-8"?><Response><Gather input="dtmf" numDigits="1" timeout="5" finishOnKey="" action="https://hupup.example/api/voice/after-add" method="POST"><Say voice="Google.en-US-Chirp3-HD-Puck" language="en-US">To keep shopping, for same day, press 1. For another day, press 2.</Say><Say voice="Google.en-US-Chirp3-HD-Puck" language="en-US">To go to your shopping cart, press 0.</Say><Play>https://hupup.example/audio/pause-500ms.wav</Play><Say voice="Google.en-US-Chirp3-HD-Puck" language="en-US">To go back, press star.</Say></Gather><Redirect method="POST">https://hupup.example/api/voice/idle?to=added-menu</Redirect></Response>"`;

