exports[`baseline: every phone step as it plays today > catalog-part 1`] = `"<?xml version="1.0" encoding="UTF-8"?><Response><Gather input="dtmf" numDigits="1" timeout="3" finishOnKey="" action="https://hupup.example/api/voice/catalog-key?part=local" method="POST"><Say voice="Google.en-US-Chirp3-HD-Puck" language="en-US">Please enter the first part of your email address, up to the at symbol. To type it, start pressing keys on your keypad now. To say it, wait for the tone, then say it letter by letter. When you are finished, please press pound.</Say><Say voice="Google.en-US-Chirp3-HD-Puck" language="en-US">To type it with your keypad, press 9.</Say></Gather><Play>https://hupup.example/audio/tone.wav</Play><Gather input="speech dtmf" finishOnKey="#" timeout="6" speechTimeout="auto" language="en-US" hints="a, b, c, d, e, f, g, h, i, j, k, l, m, n, o, p, q, r, s, t, u, v, w, x, y, z, dot, underscore, dash" action="https://hupup.example/api/voice/catalog-said?part=local" method="POST"/><Redirect method="POST">https://hupup.example/api/voice/idle?to=catalog-part&amp;q=part%3Dlocal</Redirect></Response>"`;

