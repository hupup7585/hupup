exports[`baseline: every phone step as it plays today > catalog-type 1`] = `"<?xml version="1.0" encoding="UTF-8"?><Response><Gather input="dtmf" finishOnKey="#" timeout="20" action="https://hupup.example/api/voice/catalog-typed?part=local" method="POST"><Say voice="Google.en-US-Chirp3-HD-Puck" language="en-US">Press 2 once for A, twice for B, three times for C, and so on for all keys. If two letters in a row use the same key, press star between them. To type a number, press the key one more time. To go back, press star twice. Press 0 once for a space, and twice for number 0. Press 1 once for number 1, twice for a dot, three times for a dash, and four times for an underscore. When you are finished, press the pound key.</Say><Play>https://hupup.example/audio/tone.wav</Play></Gather><Redirect method="POST">https://hupup.example/api/voice/catalog-typed?part=local</Redirect></Response>"`;

