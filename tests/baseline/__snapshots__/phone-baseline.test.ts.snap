exports[`baseline: every phone step as it plays today > book 1`] = `"<?xml version="1.0" encoding="UTF-8"?><Response><Gather input="dtmf" numDigits="1" timeout="5" finishOnKey="" action="https://hupup.example/api/voice/book-choice" method="POST"><Say voice="Google.en-US-Chirp3-HD-Puck" language="en-US">To receive our catalog by text or email, press 8.</Say><Say voice="Google.en-US-Chirp3-HD-Puck" language="en-US">The fastest way to place an order is with our easy automated system.</Say><Say voice="Google.en-US-Chirp3-HD-Puck" language="en-US">For information or questions, press 0 for customer service.</Say><Say voice="Google.en-US-Chirp3-HD-Puck" language="en-US">For jumping balloons, press 1. For laser tag, press 2. For paddle boats, press 3.</Say><Say voice="Google.en-US-Chirp3-HD-Puck" language="en-US">For schools, corporate events, and organizational bookings, press 9.</Say><Play>https://hupup.example/audio/pause-500ms.wav</Play><Say voice="Google.en-US-Chirp3-HD-Puck" language="en-US">To go back, press star.</Say></Gather><Redirect method="POST">https://hupup.example/api/voice/idle?to=book</Redirect></Response>"`;

