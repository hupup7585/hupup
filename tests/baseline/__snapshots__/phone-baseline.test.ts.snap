exports[`baseline: every phone step as it plays today > whisper 1`] = `"<?xml version="1.0" encoding="UTF-8"?><Response><Gather input="dtmf" numDigits="1" timeout="8" action="https://hupup.example/api/voice/whisper-accept" method="POST"><Say voice="Google.en-US-Chirp3-HD-Puck" language="en-US">Call from Hup Up Attractions, extension 0, Operator. Press 1 to accept, or press 2 to reject.</Say></Gather><Gather input="dtmf" numDigits="1" timeout="6" action="https://hupup.example/api/voice/whisper-accept" method="POST"><Say voice="Google.en-US-Chirp3-HD-Puck" language="en-US">Call from Hup Up Attractions, extension 0, Operator. Press 1 to accept, or press 2 to reject.</Say></Gather><Hangup/></Response>"`;

