exports[`baseline: every phone step as it plays today > cs-closed 1`] = `"<?xml version="1.0" encoding="UTF-8"?><Response><Gather input="dtmf" numDigits="1" timeout="1" finishOnKey="" action="https://hupup.example/api/voice/cs-closed-key" method="POST"><Say voice="Google.en-US-Chirp3-HD-Puck" language="en-US">Our customer service is currently closed.</Say><Say voice="Google.en-US-Chirp3-HD-Puck" language="en-US">For the best availability and fastest booking, please use our easy automated system to ensure your booking today. To get started, press 1.</Say><Say voice="Google.en-US-Chirp3-HD-Puck" language="en-US">Otherwise, leave a message after the tone, and a customer service representative will return your call on the next open day, and will help you find the best available options for your needs.</Say></Gather><Record maxLength="120" playBeep="true" finishOnKey="#" timeout="6" action="https://hupup.example/api/voice/vm-recorded?b=3&amp;x=4&amp;t=*" method="POST" recordingStatusCallback="https://hupup.example/api/voice/vm-recording?b=3&amp;t=*" recordingStatusCallbackEvent="completed" recordingStatusCallbackMethod="POST" transcribe="false"/></Response>"`;

