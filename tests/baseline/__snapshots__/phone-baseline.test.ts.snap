exports[`baseline: every phone step as it plays today > learn 1`] = `"<?xml version="1.0" encoding="UTF-8"?><Response><Gather input="dtmf" numDigits="1" timeout="5" finishOnKey="" action="https://hupup.example/api/voice/attraction-choice?m=l" method="POST"><Say voice="Google.en-US-Chirp3-HD-Puck" language="en-US">We would love to tell you about our rentals.</Say><Say voice="Google.en-US-Chirp3-HD-Puck" language="en-US">For jumping balloons, press 1. For laser tag, press 2. For paddle boats, press 3.</Say><Play>https://hupup.example/audio/pause-500ms.wav</Play><Say voice="Google.en-US-Chirp3-HD-Puck" language="en-US">To go back, press star.</Say></Gather><Redirect method="POST">https://hupup.example/api/voice/idle?to=learn&amp;q=again%3D1</Redirect></Response>"`;

exports[`baseline: every phone step as it plays today > menu 1`] = `"<?xml version="1.0" encoding="UTF-8"?><Response><Gather input="dtmf" numDigits="1" finishOnKey="" timeout="3" action="https://hupup.example/api/voice/menu-choice?t0=1799859600000" method="POST"><Say voice="Google.en-US-Chirp3-HD-Puck" language="en-US">If you know your desired extension, you may press it at any time.</Say><Play>https://hupup.example/audio/pause-500ms.wav</Play><Say voice="Google.en-US-Chirp3-HD-Puck" language="en-US">For reservations and bookings, press 1.</Say><Play>https://hupup.example/audio/pause-500ms.wav</Play><Say voice="Google.en-US-Chirp3-HD-Puck" language="en-US">For instructions and guidance on using our rental equipment, press 2.</Say><Play>https://hupup.example/audio/pause-500ms.wav</Play><Say voice="Google.en-US-Chirp3-HD-Puck" language="en-US">For customer service and general inquiries, press 3.</Say><Play>https://hupup.example/audio/pause-500ms.wav</Play><Say voice="Google.en-US-Chirp3-HD-Puck" language="en-US">For questions or assistance with any issues during your rental, press 4.</Say><Play>https://hupup.example/audio/pause-500ms.wav</Play><Say voice="Google.en-US-Chirp3-HD-Puck" language="en-US">For delivery and pickup information, press 5.</Say><Play>https://hupup.example/audio/pause-500ms.wav</Play><Say voice="Google.en-US-Chirp3-HD-Puck" language="en-US">To learn more about our rental attractions and the services we offer, press 6.</Say><Play>https://hupup.example/audio/pause-500ms.wav</Play><Say voice="Google.en-US-Chirp3-HD-Puck" language="en-US">To hear our hours of operation, press 7.</Say><Play>https://hupup.example/audio/pause-500ms.wav</Play><Say voice="Google.en-US-Chirp3-HD-Puck" language="en-US">To receive our catalog by text or email, press 8.</Say><Play>https://hupup.example/audio/pause-500ms.wav</Play><Say voice="Google.en-US-Chirp3-HD-Puck" language="en-US">For feedback and comments, press 9.</Say><Play>https://hupup.example/audio/pause-500ms.wav</Play><Say voice="Google.en-US-Chirp3-HD-Puck" language="en-US">To speak with an operator, press 0.</Say><Play>https://hupup.example/audio/pause-500ms.wav</Play><Say voice="Google.en-US-Chirp3-HD-Puck" language="en-US">To hear this menu again, press the star key.</Say><Play>https://hupup.example/audio/pause-500ms.wav</Play><Say voice="Google.en-US-Chirp3-HD-Puck" language="en-US">Thank you for choosing Hup Up Attractions!</Say></Gather><Redirect method="POST">https://hupup.example/api/voice/no-key?to=menu&amp;np=1&amp;t0=1799859600000</Redirect></Response>"`;

