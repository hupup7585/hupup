exports[`baseline: every phone step as it plays today > addr-outside 1`] = `"<?xml version="1.0" encoding="UTF-8"?><Response><Gather input="dtmf" numDigits="1" timeout="5" finishOnKey="" action="https://hupup.example/api/voice/addr-outside-choice" method="POST"><Say voice="Google.en-US-Chirp3-HD-Puck" language="en-US">We are sorry, we do not deliver to this area. We deliver only in Orange County, New York. To enter a different zip code, press 1.</Say><Play>https://hupup.example/audio/pause-500ms.wav</Play><Say voice="Google.en-US-Chirp3-HD-Puck" language="en-US">To go back, press star.</Say></Gather><Redirect method="POST">https://hupup.example/api/voice/idle?to=addr-outside</Redirect></Response>"`;

