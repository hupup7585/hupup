exports[`baseline: every phone step as it plays today > addr-street-keys 1`] = `"<?xml version="1.0" encoding="UTF-8"?><Response><Gather input="dtmf" finishOnKey="#" timeout="15" action="https://hupup.example/api/voice/addr-street-typed" method="POST"><Say voice="Google.en-US-Chirp3-HD-Puck" language="en-US">Please enter the first four letters of the street name, then press pound.</Say><Say voice="Google.en-US-Chirp3-HD-Puck" language="en-US">Press 2 once for A, twice for B, three times for C, and so on for all keys. If two letters in a row use the same key, press star between them. To type a number, press the key one more time. To go back, press star twice. Press 0 once for a space, and twice for number 0. Press 1 once for number 1, twice for a dot, three times for a dash, and four times for an underscore. When you are finished, press the pound key.</Say><Play>https://hupup.example/audio/tone.wav</Play></Gather><Redirect method="POST">https://hupup.example/api/voice/addr-street-typed</Redirect></Response>"`;

exports[`baseline: every phone step as it plays today > addr-street-none 1`] = `"<?xml version="1.0" encoding="UTF-8"?><Response><Gather input="dtmf" numDigits="1" timeout="5" finishOnKey="" action="https://hupup.example/api/voice/addr-street-none-choice" method="POST"><Say voice="Google.en-US-Chirp3-HD-Puck" language="en-US">We could not find a street that starts with those letters. To try again, press 1. To search by voice, press 2.</Say><Play>https://hupup.example/audio/pause-500ms.wav</Play><Say voice="Google.en-US-Chirp3-HD-Puck" language="en-US">To go back, press star.</Say></Gather><Redirect method="POST">https://hupup.example/api/voice/idle?to=addr-street-none</Redirect></Response>"`;

