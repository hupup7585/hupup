exports[`baseline: every phone step as it plays today > type 1`] = `"<?xml version="1.0" encoding="UTF-8"?><Response><Gather input="dtmf" finishOnKey="#" timeout="15" action="https://hupup.example/api/voice/typed?f=null" method="POST"><Say voice="Google.en-US-Chirp3-HD-Puck" language="en-US">Press 2 once for A, twice for B, three times for C, and so on for all keys. If two letters in a row use the same key, press star between them. To type a number, press the key one more time. To go back, press star twice. Press 0 once for a space, and twice for number 0. Press 1 once for number 1, twice for a dot, three times for a dash, and four times for an underscore. When you are finished, press the pound key.</Say><Play>https://hupup.example/audio/tone.wav</Play></Gather><Redirect method="POST">https://hupup.example/api/voice/typed?f=null</Redirect></Response>"`;

exports[`baseline: every phone step as it plays today > typed 1`] = `"<?xml version="1.0" encoding="UTF-8"?><Response><Say voice="Google.en-US-Chirp3-HD-Puck" language="en-US">Sorry, I did not catch that. Let's try again.</Say><Redirect method="POST">https://hupup.example/api/voice/type?f=null&amp;again=1</Redirect></Response>"`;

exports[`baseline: every phone step as it plays today > vm-act 1`] = `"<?xml version="1.0" encoding="UTF-8"?><Response><Say voice="Google.en-US-Chirp3-HD-Puck" language="en-US">Sorry, that is not a valid selection. Please try again.</Say><Redirect method="POST">https://hupup.example/api/voice/vm-after?b=0&amp;m=new&amp;v=*</Redirect></Response>"`;

exports[`baseline: every phone step as it plays today > vm-after 1`] = `"<?xml version="1.0" encoding="UTF-8"?><Response><Gather input="dtmf" numDigits="1" timeout="5" finishOnKey="" action="https://hupup.example/api/voice/vm-act" method="POST"><Say voice="Google.en-US-Chirp3-HD-Puck" language="en-US">To replay, press 4. For the date and number, press 5. To forward, press 6. To erase, press 7. To reply, press 8. To save, press 9. To keep it as new, press pound.</Say><Play>https://hupup.example/audio/pause-500ms.wav</Play><Say voice="Google.en-US-Chirp3-HD-Puck" language="en-US">To go back, press star.</Say></Gather><Redirect method="POST">https://hupup.example/api/voice/vm-after?r=1</Redirect></Response>"`;

