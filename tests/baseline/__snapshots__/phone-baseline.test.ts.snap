exports[`baseline: every phone step as it plays today > tx-enter 1`] = `"<?xml version="1.0" encoding="UTF-8"?><Response><Gather input="dtmf" numDigits="11" timeout="10" finishOnKey="#" action="https://hupup.example/api/voice/tx-heard?p=cat" method="POST"><Say voice="Google.en-US-Chirp3-HD-Puck" language="en-US">Please enter the 10-digit phone number. When you are finished, please press pound.</Say></Gather><Redirect method="POST">https://hupup.example/api/voice/idle?to=tx-enter&amp;q=p%3Dcat</Redirect></Response>"`;

